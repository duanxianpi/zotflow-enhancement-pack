{
	"name": "zotflow-enhancement-pack",
	"version": "2.0.0",
	"description": "Optional offline resources for ZotFlow reading features",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"predev": "node scripts/document-worker-resources.mjs fetch",
		"dev": "node esbuild.config.mjs",
		"prebuild": "node scripts/document-worker-resources.mjs fetch",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:startup-probes": "node scripts/startup-probes.mjs",
		"sync:document-worker": "node scripts/document-worker-resources.mjs sync",
		"release:beta:prepare": "node scripts/release-version.mjs prepare",
		"release:beta:verify": "node scripts/release-version.mjs verify",
		"version": "node version-bump.mjs && git add manifest.json versions.json document-worker.lock.json",
		"lint": "eslint .",
		"verify:pack": "node scripts/verify-pack.mjs",
		"postbuild": "npm run verify:pack && npm run test:protocol",
		"test:protocol": "node --test scripts/pack-container.test.mjs",
		"test:release-tools": "node --test scripts/release-tools.test.mjs",
		"test": "npm run lint && npm run test:protocol && npm run test:release-tools"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jszip": "^3.10.1",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
